<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.demo</groupId>
  <artifactId>springboot-test</artifactId>
  <packaging>pom</packaging>
  <version>1.0.0</version>

  <name>springboot-test</name>
  <description>SpringBoot测试</description>

  <parent>
    <!--SpringBoot Parent-->
    <!--org.springframework.boot:spring-boot-starter-parent-->
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.8</version>
  </parent>

  <modules>
    <module>demo-test</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--项目父模板-->
    <!--cn.404z:parent-->
    <cn.404z.parent.version>1.7.0</cn.404z.parent.version>

    <!--高性能时钟-->
    <!--cn.404z:clock-->
    <clock.version>2.8.0</clock.version>

    <!--雪花ID生成器-->
    <!--cn.404z:id-->
    <!--cn.404z:id-spring-boot-autoconfigure-->
    <id.version>3.4.0.single</id.version>

    <!--IP地址转区域-->
    <!--cn.404z:ip2region-->
    <!--cn.404z:ip2region-spring-boot-autoconfigure-->
    <ip2region.version>3.4.0</ip2region.version>

    <!--手机号码转区域-->
    <!--cn.404z:phone2region-->
    <!--cn.404z:phone2region-spring-boot-autoconfigure-->
    <phone2region.version>2.4.0</phone2region.version>

    <!--二维码生成器-->
    <!--cn.404z:qrcode-encoder-->
    <qrcode-encoder.version>1.4.0</qrcode-encoder.version>

    <!--轻量级集群任务SpringBoot启动器-->
    <!--cn.404z:tiny-task-spring-boot-starter-->
    <tiny-task.version>1.6.0</tiny-task.version>

    <!--轻量级权限认证SpringBoot启动器-->
    <!--cn.404z:tiny-token-spring-boot-starter-->
    <tiny-token.version>1.8.0.v3.auth</tiny-token.version>
  </properties>

  <dependencies>
    <!--热部署-->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <!--实体层注解-->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <!--日志-->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <!--项目父模板-->
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>parent</artifactId>
        <version>${cn.404z.parent.version}</version>
        <type>pom</type>
      </dependency>
      <!--高性能时钟-->
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>clock</artifactId>
        <version>${clock.version}</version>
      </dependency>
      <!--雪花ID生成器-->
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>id</artifactId>
        <version>${id.version}</version>
        <exclusions>
          <exclusion>
            <groupId>cn.404z</groupId>
            <artifactId>clock</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>id-spring-boot-autoconfigure</artifactId>
        <version>${id.version}</version>
        <exclusions>
          <exclusion>
            <groupId>cn.404z</groupId>
            <artifactId>id</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <!--IP地址转区域-->
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>ip2region</artifactId>
        <version>${ip2region.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>ip2region-spring-boot-autoconfigure</artifactId>
        <version>${ip2region.version}</version>
        <exclusions>
          <exclusion>
            <groupId>cn.404z</groupId>
            <artifactId>ip2region</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <!--手机号码转区域-->
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>phone2region</artifactId>
        <version>${phone2region.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>phone2region-spring-boot-autoconfigure</artifactId>
        <version>${phone2region.version}</version>
        <exclusions>
          <exclusion>
            <groupId>cn.404z</groupId>
            <artifactId>phone2region</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <!--二维码生成器-->
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>qrcode-encoder</artifactId>
        <version>${qrcode-encoder.version}</version>
      </dependency>
      <!--轻量级集群任务SpringBoot启动器-->
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>tiny-task-spring-boot-starter</artifactId>
        <version>${tiny-task.version}</version>
      </dependency>
      <!--轻量级权限认证SpringBoot启动器-->
      <dependency>
        <groupId>cn.404z</groupId>
        <artifactId>tiny-token-spring-boot-starter</artifactId>
        <version>${tiny-token.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
